read_verilog out/primitives.v out/puzzle.generic.v
prep -top puzzle -flatten
async2sync
design -stash gold

read_verilog out/primitives.v out/puzzle.rtl.v
prep -top puzzle -flatten
async2sync
design -stash gate

design -copy-from gold -as gold puzzle
design -copy-from gate -as gate puzzle
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -tempinduct -set-init-zero -seq 4 miter
