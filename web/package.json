    "test:notebook": "node --experimental-strip-types scripts/test-notebook-verify.mjs",
    "test:experiments": "node --experimental-strip-types scripts/test-experiments.mjs",
    "test:model": "node --experimental-strip-types scripts/test-model-diff.mjs",
    "test:writeup": "node --experimental-strip-types scripts/test-writeup.mjs",
    "test:scoring": "node --experimental-strip-types scripts/test-scoring.mjs",
    "test:coverage-plumbing": "node --experimental-strip-types scripts/test-coverage-plumbing.mjs",
    "test:puzzles": "node --experimental-strip-types scripts/test-puzzles.mjs",
    "test:guide": "node --experimental-strip-types scripts/test-guide.mjs",
